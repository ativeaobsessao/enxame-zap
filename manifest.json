{
  "manifest_version": 3,
  "name": "Enxame Zap - Funil HQ & PTT ZapVoice",
  "version": "2.8.3",
  "description": "Barra de pills no WhatsApp Web para envio com 1 clique de áudios PTT ZapVoice 48kHz, textos com {{nome}}, mídias e funis com delay humanizado.",
  "permissions": ["storage", "downloads"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "lib/main-file-intercept.js",
        "lib/wpp-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "lib/jszip.min.js",
        "lib/audio-pipeline.js",
        "lib/ffmpeg.js",
        "lib/bridge-client.js",
        "lib/dom-sender.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "builder.html",
        "builder.css",
        "builder.js",
        "popup.html",
        "popup.js",
        "lib/*",
        "icons/*",
        "lib/audio-worker.js"
      ],
      "matches": ["https://web.whatsapp.com/*", "<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Enxame Zap",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}